<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0-windows (não net8.0 puro): o Lite só publica assets net48 / net8.0-windows /
         net10.0-windows. Um teste net8.0 puro é incompatível com o asset net8.0-windows e o
         NuGet cairia no asset net48 via shim (NU1701) — com STJ/DPAPI errados. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>NodeAec.Licensing.Lite.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- DPAPI no helper de escrita do lease (round-trip arquivo); com fallback em memória. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NodeAec.Licensing.Lite\NodeAec.Licensing.Lite.csproj" />
  </ItemGroup>

</Project>
